{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/geocode",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/weather/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/air-quality/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/climate-risk/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/historical/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/forecast/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
