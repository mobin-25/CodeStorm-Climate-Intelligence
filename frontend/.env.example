# Set to true to activate live backend endpoints (false or omitted falls back to corridor demo data)
NEXT_PUBLIC_USE_REAL_BACKEND=true

# URL of the deployed FastAPI backend (used by Next.js server-side rewrites to proxy API calls)
BACKEND_URL=http://localhost:8000

# Optional: Direct public API URL (if bypassing Next.js rewrites in the browser)
NEXT_PUBLIC_API_URL=
