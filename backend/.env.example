# Upstream provider timeout guards for Vercel serverless execution limits (Hobby 10s–15s cap)
ARCHIVE_REQUEST_TIMEOUT_SECONDS=10.0
HISTORICAL_REQUEST_TIMEOUT_SECONDS=10.0

# Server-side API keys (Kept strictly on the backend, never exposed to client bundles)
CPCB_API_KEY=
DATA_GOV_IN_API_KEY=

# Optional CORS origins (localhost and https://*.vercel.app are automatically permitted)
CORS_ORIGINS=

